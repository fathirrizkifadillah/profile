# Private password required to log into /admin
ADMIN_PASSWORD=ganti-dengan-password-rahasia-kamu

# Optional: random 32+ char string for signing session cookies
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Optional Cloud Persistence on Vercel (Option 1 - Recommended: Free Upstash Redis via Vercel Storage)
# Automatically injected when you connect Upstash Redis in Vercel -> Storage
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional Cloud Persistence on Vercel (Option 2: GitHub Repo JSON Commit)
# GITHUB_TOKEN=
# GITHUB_DATA_REPO=fathirrizkifadillah/profile
# GITHUB_DATA_BRANCH=main
